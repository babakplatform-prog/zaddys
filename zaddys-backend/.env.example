# Django must use a long, unique production secret.
SECRET_KEY=replace_with_a_long_random_django_secret
DEBUG=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Comma-separated hostnames accepted by Django. Include the Render hostname
# and your custom API domain if you configure one.
ALLOWED_HOSTS=zaddys-api.onrender.com,api.zaddys.ng

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://zaddys.vercel.app,https://www.zaddys.ng

# Use the Internal Database URL from Render PostgreSQL.
DATABASE_URL=postgresql://user:password@hostname:5432/database

# Paystack secret key. Use sk_test_... until live payment testing is complete.
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret

# Resend API key and a verified sender address/domain.
RESEND_API_KEY=re_replace_with_resend_api_key
DEFAULT_FROM_EMAIL=orders@zaddys.ng
